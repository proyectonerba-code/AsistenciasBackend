{
  "name": "asistencias-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend del Control de Asistencia: API /api/checar, migraciones SQL, motor de tz, haversine, rate-limit, cliente Supabase service role.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "migraciones": "node supabase/aplicar-migraciones.mjs",
    "migraciones:verificar": "node supabase/aplicar-migraciones.mjs --verificar",
    "migraciones:reset": "node supabase/aplicar-migraciones.mjs --reset",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "wrangler": "^4.152.0"
  }
}