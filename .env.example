# ============================================================
# Control de Asistencia — Backend (service role, SOLO servidor)
# Copia este archivo a .env.local y configura las variables.
# Nunca subas .env.local al repositorio.
# ============================================================

# --- Supabase (obligatorio) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# --- Modo demostración (opcional) ---
# Con SUPABASE_DEMO=1 se usa un cliente Supabase simulado en memoria
# con el catálogo de 11 usuarios y 6 semanas de historial.
# NO lo actives en producción.
SUPABASE_DEMO=0

# --- CORS ---
# Orígenes permitidos de la vista de registro, separados por coma.
# Admite comodines de dominio: "*.netlify.app" (Netlify genera una URL
# distinta en cada vista previa).
# Si lo dejas vacío se permiten todos.
ALLOWED_ORIGIN=http://localhost:3000,https://*.netlify.app

# NIP de cuatro dígitos para solicitar alta de un celular. Usa secretos
# aleatorios largos y configura el mismo PIN_PEPPER en el panel administrador.
PIN_PEPPER=cambia_este_secreto_aleatorio_largo
RATE_LIMIT_PEPPER=cambia_este_otro_secreto_aleatorio_largo

# Secreto para firmar las sesiones de terminal (5 min de vigencia).
# Genera uno con:  node -e "console.log(require('crypto').randomUUID())"
SESSION_SECRET=cambia_este_secreto_por_uno_aleatorio_largo

# --- Avisos al administrador ---
CRON_SECRET=cambia_este_secreto_por_uno_aleatorio_largo
ADMIN_ALERT_EMAIL=admin@tuempresa.mx

# EMAIL_PROVIDER: "console" (solo log) o "resend" (correo real)
EMAIL_PROVIDER=console
RESEND_API_KEY=re_respuesta_de_resend
RESEND_FROM=Asistencias <asistencias@tuempresa.mx>

# --- Zona horaria del sistema ---
TZ=America/Mexico_City
